{
  "entities": {
    "Candidate": {
      "title": "Candidate",
      "description": "Student admission application record",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "ic": { "type": "string", "maxLength": 20 },
        "name": { "type": "string", "maxLength": 200 },
        "statusTemuduga": { "type": "string", "enum": ["MENUNGGU", "LAYAK", "TIDAK_LAYAK", "HADIR", "TIDAK_HADIR"] },
        "statusTawaran": { "type": "string", "enum": ["DALAM_PERTIMBANGAN", "BERJAYA", "SIMPANAN", "TIDAK_LAYAK"] },
        "maklumBalasTawaran": { "type": "string", "enum": ["TERIMA", "TOLAK", ""] }
      },
      "required": ["ic", "name", "statusTemuduga", "statusTawaran"]
    },
    "Config": {
      "title": "Config",
      "description": "System-wide admission settings and dates",
      "type": "object",
      "properties": {
        "sesiKemasukan": { "type": "string", "maxLength": 32 },
        "borangBuka": { "type": "boolean" },
        "temudugaBuka": { "type": "boolean" },
        "tawaranBuka": { "type": "boolean" }
      }
    },
    "User": {
      "title": "User",
      "description": "Staff, panel and admin accounts",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "username": { "type": "string", "maxLength": 64 },
        "name": { "type": "string", "maxLength": 128 },
        "role": { "type": "string", "enum": ["SUPER_ADMIN", "TAHFIZ", "AKADEMIK", "PENTADBIR"] }
      },
      "required": ["id", "username", "name", "role"]
    },
    "Infographic": {
      "title": "Infographic",
      "description": "Public announcement and flyer items",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "title": { "type": "string", "maxLength": 256 },
        "url": { "type": "string", "maxLength": 1024 }
      }
    }
  },
  "firestore": {
    "candidates/{candidateId}": {
      "schema": { "$ref": "#/entities/Candidate" },
      "description": "Student application records and evaluation results"
    },
    "config/{configId}": {
      "schema": { "$ref": "#/entities/Config" },
      "description": "System settings and admission timeline parameters"
    },
    "users/{userId}": {
      "schema": { "$ref": "#/entities/User" },
      "description": "Authorized evaluator and administrator accounts"
    },
    "infographics/{infoId}": {
      "schema": { "$ref": "#/entities/Infographic" },
      "description": "School visual guides and announcement flyers"
    }
  }
}
